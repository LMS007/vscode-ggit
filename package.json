{
  "name": "vscode-ggit",
  "displayName": "Ggit",
  "description": "A minimal, Tower-style git branch/history viewer for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ggit",
          "title": "Ggit",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ggit": [
        {
          "id": "ggitBranches",
          "name": "Branches"
        },
        {
          "id": "ggitRemotes",
          "name": "Remotes"
        }
      ]
    },
    "commands": [
      {
        "command": "ggit.openBranchHistory",
        "title": "Ggit: Open Branch History"
      },
      {
        "command": "ggit.fetch",
        "title": "Ggit: Fetch",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ggit.pull",
        "title": "Ggit: Pull",
        "icon": "$(arrow-down)"
      },
      {
        "command": "ggit.refresh",
        "title": "Ggit: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ggit.fetch",
          "when": "view == ggitRemotes",
          "group": "navigation@0"
        },
        {
          "command": "ggit.pull",
          "when": "view == ggitRemotes",
          "group": "navigation@1"
        },
        {
          "command": "ggit.refresh",
          "when": "view == ggitRemotes",
          "group": "navigation@2"
        },
        {
          "command": "ggit.refresh",
          "when": "view == ggitBranches",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "simple-git": "^3.36.0"
  }
}
