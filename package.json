{
  "name": "vscode-ggit",
  "displayName": "GGit",
  "description": "A minimal, Tower-style git branch/history viewer for VS Code",
  "version": "0.0.1",
  "publisher": "kylekeating",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ggit",
          "title": "GGit",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ggit": [
        {
          "id": "ggitConflicts",
          "name": "Conflicts",
          "when": "ggit.rebaseInProgress",
          "initialSize": 2
        },
        {
          "id": "ggitCommitLauncher",
          "name": "Commit",
          "type": "webview",
          "when": "false",
          "initialSize": 1
        },
        {
          "id": "ggitWorkingCopy",
          "name": "Working Copy",
          "initialSize": 2
        },
        {
          "id": "ggitBranches",
          "name": "Branches",
          "initialSize": 5
        },
        {
          "id": "ggitRemotes",
          "name": "Remotes",
          "initialSize": 3
        },
        {
          "id": "ggitStashes",
          "name": "Stashes",
          "initialSize": 2
        }
      ]
    },
    "commands": [
      {
        "command": "ggit.openBranchHistory",
        "title": "GGit: Open Branch History"
      },
      {
        "command": "ggit.createBranch",
        "title": "GGit: Create Branch",
        "icon": "$(add)"
      },
      {
        "command": "ggit.fetch",
        "title": "GGit: Fetch",
        "icon": "$(cloud-download)"
      },
      {
        "command": "ggit.pull",
        "title": "GGit: Pull",
        "icon": "$(arrow-down)"
      },
      {
        "command": "ggit.push",
        "title": "GGit: Push",
        "icon": "$(arrow-up)"
      },
      {
        "command": "ggit.sync",
        "title": "GGit: Sync",
        "icon": "$(sync)"
      },
      {
        "command": "ggit.rebase",
        "title": "GGit: Rebase",
        "icon": "$(git-merge)"
      },
      {
        "command": "ggit.rebaseContinue",
        "title": "GGit: Continue Rebase",
        "icon": "$(check)"
      },
      {
        "command": "ggit.rebaseSkip",
        "title": "GGit: Skip Commit",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "ggit.rebaseAbort",
        "title": "GGit: Abort Rebase",
        "icon": "$(circle-slash)"
      },
      {
        "command": "ggit.markConflictResolved",
        "title": "Mark as Resolved"
      },
      {
        "command": "ggit.refresh",
        "title": "GGit: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "ggit.stageAll",
        "title": "GGit: Stage All",
        "icon": "$(add)"
      },
      {
        "command": "ggit.unstageAll",
        "title": "GGit: Unstage All",
        "icon": "$(remove)"
      },
      {
        "command": "ggit.commit",
        "title": "GGit: Commit",
        "icon": "$(check)"
      },
      {
        "command": "ggit.stashAll",
        "title": "GGit: Stash All Changes",
        "icon": "$(archive)"
      },
      {
        "command": "ggit.applyStash",
        "title": "GGit: Apply Stash",
        "icon": "$(inbox)"
      },
      {
        "command": "ggit.stashSelectedFiles",
        "title": "Stash Selected Files"
      },
      {
        "command": "ggit.openWorkingChangeFile",
        "title": "Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "ggit.discardChanges",
        "title": "Discard Local Changes"
      },
      {
        "command": "ggit.createBranchFrom",
        "title": "Create New Branch from Here"
      },
      {
        "command": "ggit.deleteLocalBranch",
        "title": "Delete Local Branch",
        "enablement": "viewItem != 'branch-head' && viewItem != 'branch-other-worktree'"
      },
      {
        "command": "ggit.renameLocalBranch",
        "title": "Rename Local Branch"
      },
      {
        "command": "ggit.copyBranchName",
        "title": "Copy Branch Name"
      },
      {
        "command": "ggit.applyStashItem",
        "title": "Apply Stash"
      },
      {
        "command": "ggit.deleteStash",
        "title": "Delete Stash"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ggit.createBranch",
          "when": "view == ggitBranches",
          "group": "navigation@0"
        },
        {
          "command": "ggit.fetch",
          "when": "view == ggitBranches",
          "group": "navigation@1"
        },
        {
          "command": "ggit.pull",
          "when": "view == ggitBranches",
          "group": "navigation@2"
        },
        {
          "command": "ggit.push",
          "when": "view == ggitBranches",
          "group": "navigation@3"
        },
        {
          "command": "ggit.sync",
          "when": "view == ggitBranches",
          "group": "navigation@4"
        },
        {
          "command": "ggit.refresh",
          "when": "view == ggitBranches",
          "group": "navigation@5"
        },
        {
          "command": "ggit.rebase",
          "when": "view == ggitBranches",
          "group": "navigation@6"
        },
        {
          "command": "ggit.refresh",
          "when": "view == ggitRemotes",
          "group": "navigation"
        },
        {
          "command": "ggit.rebaseContinue",
          "when": "view == ggitConflicts",
          "group": "navigation@0"
        },
        {
          "command": "ggit.rebaseSkip",
          "when": "view == ggitConflicts",
          "group": "navigation@1"
        },
        {
          "command": "ggit.rebaseAbort",
          "when": "view == ggitConflicts",
          "group": "navigation@2"
        },
        {
          "command": "ggit.applyStash",
          "when": "view == ggitWorkingCopy",
          "group": "navigation@0"
        },
        {
          "command": "ggit.stashAll",
          "when": "view == ggitWorkingCopy",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ggit.stashSelectedFiles",
          "when": "view == ggitWorkingCopy && viewItem != 'createCommitAction'",
          "group": "1_modification"
        },
        {
          "command": "ggit.openWorkingChangeFile",
          "when": "view == ggitWorkingCopy && viewItem != 'createCommitAction'",
          "group": "inline"
        },
        {
          "command": "ggit.discardChanges",
          "when": "view == ggitWorkingCopy && viewItem != 'createCommitAction'",
          "group": "2_discard"
        },
        {
          "command": "ggit.createBranchFrom",
          "when": "view == ggitBranches && viewItem =~ /^branch-/",
          "group": "1_create@1"
        },
        {
          "command": "ggit.renameLocalBranch",
          "when": "view == ggitBranches && viewItem =~ /^branch-/",
          "group": "2_modify@1"
        },
        {
          "command": "ggit.copyBranchName",
          "when": "view == ggitBranches && viewItem =~ /^branch-/",
          "group": "2_modify@2"
        },
        {
          "command": "ggit.deleteLocalBranch",
          "when": "view == ggitBranches && viewItem =~ /^branch-/",
          "group": "9_delete@1"
        },
        {
          "command": "ggit.markConflictResolved",
          "when": "view == ggitConflicts",
          "group": "1_modification"
        },
        {
          "command": "ggit.applyStashItem",
          "when": "view == ggitStashes && viewItem == stash",
          "group": "1_apply@1"
        },
        {
          "command": "ggit.deleteStash",
          "when": "view == ggitStashes && viewItem == stash",
          "group": "9_delete@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "simple-git": "^3.36.0"
  }
}
